{
  "name": "dimcraft",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @dimcraft/dimcrochet",
    "dev:knit": "npm run dev -w @dimcraft/dimknit",
    "build": "npm run typecheck && npm run build -w @dimcraft/dimcrochet",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p apps/dimcrochet && tsc --noEmit -p apps/dimknit",
    "preview": "npm run preview -w @dimcraft/dimcrochet",
    "test": "vitest run",
    "test:watch": "vitest",
    "commons-pack": "npm run commons-pack -w @dimcraft/dimcrochet"
  },
  "dependencies": {
    "idb-keyval": "^6.2.1",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svg2pdf.js": "^2.2.4",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
